# Elpaca (pacotes do Emacs - gerados automaticamente)
emacs/.config/emacs/*
!emacs/.config/emacs/config.org
!emacs/.config/emacs/early-init.el
!emacs/.config/emacs/init.el
!emacs/.config/emacs/images
!emacs/.config/emacs/scripts
!emacs/.config/emacs/themes

# Nvim se tiver repos embutidos
nvim/.config/nvim/.git

# Wallpaper selector - ignora tudo exceto os scripts
wallpaper_selector/*
!wallpaper_selector/selector.py
!wallpaper_selector/run.sh
spotify/.config/spotify/Users/

# Spotify
spotify/.config/spotify/Users/
spotify/.config/spotify/Data/
spotify/.config/spotify/Storage/

# General
*.bak
*.tmp
*.log
.DS_Store
Thumbs.db

# Neovim
nvim/.config/nvim/undo/
nvim/.config/nvim/swap/
nvim/.config/nvim/backup/
nvim/.config/nvim/view/

# Emacs
emacs/.config/emacs/auto-save-list/
emacs/.config/emacs/eln-cache/
emacs/.config/emacs/elpa/
emacs/.config/emacs/elpaca/
